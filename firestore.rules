rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Username→email lookup: readable without auth so sign-in works on a fresh
    // device before the user is authenticated. Writable only by signed-in users
    // (during sign-up the account already exists at write time).
    match /rewatt_usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profile document
    match /rewatt_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Per-device space names and any other user subcollections
    match /rewatt_users/{uid}/{subcollection=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Room sensor data — any signed-in user (Admin or Sensor) can read all
    // halls; Sensors write their own perception data here.
    match /rooms/{roomId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
