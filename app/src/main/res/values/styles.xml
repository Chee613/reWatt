<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReWatt" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>

    <style name="Theme.ReWatt.Alert" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#B91C1C</item>
        <item name="android:navigationBarColor">#B91C1C</item>
        <item name="android:windowBackground">@color/rewatt_alert_red</item>
    </style>
</resources>

